{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/_serverFn/:path*",
      "destination": "https://autovere.lovable.app/_serverFn/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://autovere.lovable.app/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/usa",
      "destination": "/us",
      "permanent": true
    },
    {
      "source": "/usa/:page",
      "destination": "/us/:page",
      "permanent": true
    }
  ]
}
